# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit shell script normalization (strictly LF across Windows, macOS, Linux)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# Embedded & C++ source code
*.cpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.ini text eol=lf

# Web, TypeScript, React source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf

# Documentation & Structured Data
*.md text diff=markdown
*.json text
*.yml text
*.yaml text

# Binary assets (avoid corruption or line-ending conversions)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.bin binary

# Release Archive Exclusions (keep distribution tarballs clean)
.github export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.editorconfig export-ignore
.markdownlint.json export-ignore
