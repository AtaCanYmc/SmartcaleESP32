# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,c,h,hpp,ino}]
indent_size = 2

[*.py]
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
